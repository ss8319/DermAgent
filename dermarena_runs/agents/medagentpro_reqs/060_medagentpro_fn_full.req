# 060 (h200x4b) — MedAgent-Pro x Qwen3.8-Flash-Next FULL run; tools on the L40S (4 procs x 32 threads). Needs canary_iclr3 integrity PASS.
# Plans: owner accepted without review (11-08) -> REVIEWED is written here for the namespace the canary used. Resumable: the holder ends 10:47; re-queue on h200x4c.
MODEL=Qwen/Qwen3.8-Flash-Next
SERVE_ARGS="--tp-size 4 --ep-size 4 --dtype bfloat16 --reasoning-parser qwen3 --tool-call-parser qwen3_coder --chunked-prefill-size 8192 --max-running-requests 160 --cuda-graph-max-bs-decode 160"
CTX=81920
source /fs04/scratch2/ub62/ssim0070/benchmark_runs/local_weights.sh; local_weights "$MODEL" || return 1
export SGLANG_CONTAINER=/fs04/scratch2/ub62/ssim0070/sglang/containers/sglang_v0522.sif
export CONTAINER_HOME=/fs04/scratch2/ub62/ssim0070/sglang/.container_home_v0522
mkdir -p $CONTAINER_HOME/.cache/flashinfer $CONTAINER_HOME/.cache/torch $CONTAINER_HOME/.triton
[ -s "$SGLANG_CONTAINER" ] || { echo "missing $SGLANG_CONTAINER"; return 1; }
[ "$MODEL|${CTX:-65536}|${SERVE_ARGS:-}" != "${CUR:-}" ] && bash /fs04/scratch2/ub62/ssim0070/benchmark_runs/clean_gpu.sh
run() {
  local B=/fs04/scratch2/ub62/ssim0070/benchmark_runs S=medagentpro-qwen3.8-flash-next L=61714874 BB=Qwen/Qwen3.8-Flash-Next
  local D=$B/dx/medagentpro-qwen3.8-flash-next URL=${OPENROUTER_BASE_URL/127.0.0.1/$(hostname)}
  [ -f $D/canary_iclr3/PASSED_INTEGRITY ] || { echo "Flash-Next canary_iclr3 did not pass its integrity check: no full run"; return 1; }
  local ns; ns=$(grep -ho "plan cache [^ ]*" $D/logs/canary_p*.log | tail -1 | awk '{print $3}')
  [ -d "$ns" ] || { echo "cannot find the canary's plan namespace"; return 1; }
  echo "owner 2026-11-08: MedAgent-Pro's own plans, accepted without per-plan review" > $ns/REVIEWED
  srun --jobid=$L --overlap --cpu-bind=none -n1 -c1 --mem=1G bash $B/clean_gpu.sh
  bash $B/tools/guarded.sh "${OPENROUTER_BASE_URL%/v1}/health" bash $B/agents/run_medagentpro_remote_v2.sh $L "$URL" full \
    MP_SLUG=$S MP_BACKBONE=$BB MP_THREADS=32 MP_ALLOC_CONF=expandable_segments:True "MP_SERVER_ARGS='$SERVE_ARGS --context-length $CTX'"
}
