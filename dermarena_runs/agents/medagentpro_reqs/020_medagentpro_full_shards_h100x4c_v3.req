# 020 v3 (h100x4c, 11-11 11:40) — Qwen FULL: shards 0 and 1 on ONE H100 server (holder's, GPUs 0-1, tp2, 32 threads each), and GPUs 2-3 of
# this job become a TOOLS HOST (job id appended to agents/mp_tool_hosts.txt; 80 GB each = up to 6 runners). Why: the L40S tools job ends
# 12 Nov 11:52 and the preemptible abl_a100 cannot be relied on, so tool slots must come from a job that lives to Fri. Replaces v2 (2 servers).
# mp_take_shard.sh stops each shard's current runner by exact process group and restarts it here (tools on the longest-lived free slot).
MODEL=Qwen/Qwen3.5-27B
SERVE_ARGS="--tp-size 2 --reasoning-parser qwen3 --tool-call-parser qwen3_coder --mem-fraction-static 0.90 --cuda-graph-max-bs 64 --mamba-full-memory-ratio 2.0"
CTX=131072
source /fs04/scratch2/ub62/ssim0070/benchmark_runs/local_weights.sh; local_weights "$MODEL" || return 1
[ "$MODEL|${CTX:-65536}|${SERVE_ARGS:-}" != "${CUR:-}" ] && bash /fs04/scratch2/ub62/ssim0070/benchmark_runs/clean_gpu.sh
run() {
  local B=/fs04/scratch2/ub62/ssim0070/benchmark_runs D=/fs04/scratch2/ub62/ssim0070/benchmark_runs/dx/medagentpro-qwen3.5-27b got="" H=$(hostname)
  grep -q "^$SLURM_JOB_ID " $B/agents/mp_tool_hosts.txt || echo "$SLURM_JOB_ID  # bench-h100x4c H100 GPUs 2-3 = tools host (020 v3), ends $(squeue -h -j $SLURM_JOB_ID -o %e)" >> $B/agents/mp_tool_hosts.txt
  for x in 0 1; do NOWAIT=1 bash $B/agents/mp_shard_lock.sh $D/locks/shard$x $SLURM_JOB_ID && got="$got $x"; done
  [ -z "$got" ] && { echo "surplus: shard0 and shard1 owned by running jobs (GPUs 2-3 stay a tools host)"; return 3; }
  trap "for x in $got; do [ \"\$(cat $D/locks/shard\$x/owner 2>/dev/null)\" = \"$SLURM_JOB_ID\" ] && rm -rf $D/locks/shard\$x; done" EXIT
  local pids=""; for s in $got; do bash $B/agents/mp_take_shard.sh $s "http://$H:$PORT/v1" x 32 & pids="$pids $!"; sleep 60; done
  local rc=0; for p in $pids; do wait $p || rc=$?; done; return $rc
}
