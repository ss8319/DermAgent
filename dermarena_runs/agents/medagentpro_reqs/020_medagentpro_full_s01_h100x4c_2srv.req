# 020 (h100x4c) — Qwen FULL shards 0-1 after h100x4 ends, OPTIMISED (owner 11-08): 2 Qwen servers on the 4 H100s (holder's on GPUs 0-1, a second
# identical one on GPUs 2-3, port+1), tools on L40S GPUs 2-3 (1 proc per shard, 64 threads). Waits for the shards01 lock.
MODEL=Qwen/Qwen3.5-27B
SERVE_ARGS="--tp-size 2 --reasoning-parser qwen3 --tool-call-parser qwen3_coder --mem-fraction-static 0.90 --cuda-graph-max-bs 64 --mamba-full-memory-ratio 2.0"
CTX=131072
source /fs04/scratch2/ub62/ssim0070/benchmark_runs/local_weights.sh; local_weights "$MODEL" || return 1
[ "$MODEL|${CTX:-65536}|${SERVE_ARGS:-}" != "${CUR:-}" ] && bash /fs04/scratch2/ub62/ssim0070/benchmark_runs/clean_gpu.sh
run() {
  local B=/fs04/scratch2/ub62/ssim0070/benchmark_runs S=medagentpro-qwen3.5-27b L=61714874 D=/fs04/scratch2/ub62/ssim0070/benchmark_runs/dx/medagentpro-qwen3.5-27b
  # 11-09: non-blocking. Another RUNNING job owns this agent work -> this holder is surplus: return 3 and the holder moves on to
  # its ablation requests, which hand the GPU back as soon as the agent work needs it (agents/mp_ablation_yield.sh)
  NOWAIT=1 bash $B/agents/mp_shard_lock.sh $D/locks/shards01 $SLURM_JOB_ID || { echo "surplus: shards01 owned by a running job"; return 3; }
  # release the lock when this request ends (finished, stopped or killed), so the next holder can resume shards 0-1 at once
  trap '[ "$(cat $D/locks/shards01/owner 2>/dev/null)" = "$SLURM_JOB_ID" ] && rm -rf $D/locks/shards01' EXIT
  # the A100 servers run shards 0-1 as extras while no replacement exists (11-09): raise the flag, give them time to stop
  echo $SLURM_JOB_ID > $D/locks/TAKEOVER_01; echo "takeover flag raised $(date)"; sleep 120
  local P2=$((PORT + 1)) H=$(hostname)
  CUDA_VISIBLE_DEVICES=2,3 apptainer exec --nv --home "${CONTAINER_HOME}:${CONTAINER_HOME}" --bind "${REPO}:${REPO}" \
    --env "HF_HOME=${HF_HOME}" --env "HUGGINGFACE_HUB_CACHE=${HUGGINGFACE_HUB_CACHE}" \
    --env "TRANSFORMERS_CACHE=${TRANSFORMERS_CACHE}" --env "HF_HUB_OFFLINE=1" --env "TRANSFORMERS_OFFLINE=1" \
    --env "FLASHINFER_WORKSPACE_DIR=${CONTAINER_HOME}/.cache/flashinfer" \
    --env "TRITON_CACHE_DIR=${CONTAINER_HOME}/.triton" --env "TORCH_HOME=${CONTAINER_HOME}/.cache/torch" \
    "${SGLANG_CONTAINER}" python3 -m sglang.launch_server --model-path "$MODEL" --host 0.0.0.0 --port $P2 \
      --context-length "$CTX" --mem-fraction-static 0.85 --trust-remote-code $SERVE_ARGS >> $OUT/server2_${SLURM_JOB_ID}.log 2>&1 &
  local SP2=$!
  trap "kill $SP2 2>/dev/null" RETURN
  for i in $(seq 1 240); do curl -sf http://127.0.0.1:$P2/health >/dev/null && break; kill -0 $SP2 2>/dev/null || break; sleep 10; done
  curl -sf http://127.0.0.1:$P2/health >/dev/null || { echo "second server failed: falling back to one server for both shards"; 
    MP_REMOTE_CPUS=4 MP_REMOTE_MEM=24G bash $B/tools/guarded.sh "${OPENROUTER_BASE_URL%/v1}/health" bash $B/agents/run_medagentpro_remote_v2.sh $L "http://$H:$PORT/v1" full \
      MP_SLUG=$S MP_BACKBONE=Qwen/Qwen3.5-27B "MP_TOOL_GPUS='2 3'" MP_NPROC=2 MP_THREADS=32 MP_SHARD_BASE=0 MP_SHARD_TOTAL=4 \
      MP_ALLOC_CONF=expandable_segments:True "MP_SERVER_ARGS='$SERVE_ARGS --context-length $CTX'"; return $?; }
  echo "second server ready on $H:$P2 $(date)"
  MP_REMOTE_CPUS=4 MP_REMOTE_MEM=16G bash $B/tools/guarded.sh "http://127.0.0.1:$PORT/health" bash $B/agents/run_medagentpro_remote_v2.sh $L "http://$H:$PORT/v1" full \
    MP_SLUG=$S MP_BACKBONE=Qwen/Qwen3.5-27B "MP_TOOL_GPUS='2'" MP_NPROC=1 MP_THREADS=64 MP_SHARD_BASE=0 MP_SHARD_TOTAL=4 \
    MP_ALLOC_CONF=expandable_segments:True "MP_SERVER_ARGS='$SERVE_ARGS --context-length $CTX'" &
  local g1=$!
  sleep 20
  MP_REMOTE_CPUS=4 MP_REMOTE_MEM=16G bash $B/tools/guarded.sh "http://127.0.0.1:$P2/health" bash $B/agents/run_medagentpro_remote_v2.sh $L "http://$H:$P2/v1" full \
    MP_SLUG=$S MP_BACKBONE=Qwen/Qwen3.5-27B "MP_TOOL_GPUS='3'" MP_NPROC=1 MP_THREADS=64 MP_SHARD_BASE=1 MP_SHARD_TOTAL=4 \
    MP_ALLOC_CONF=expandable_segments:True "MP_SERVER_ARGS='$SERVE_ARGS --context-length $CTX'" &
  local g2=$!
  local rc=0; wait $g1 || rc=$?; wait $g2 || rc=$?; return $rc
}
