# 037 (gpu2a100, 11-12 13:45): ROLLING judge so the Qwen3.6-27B judge server does not idle between batches of finished agent cases.
# Every 20 min: race-safe merge (unique tmp + os.replace, refuses >1 run_sig) + resumable judge_dx.sh for BOTH MedAgent-Pro runs
# (Qwen3.5-27B T1.2 tail, Qwen3.8-Flash-Next). Exits when Qwen inference is complete (041 then does the final Qwen judge) or on
# dx/medagentpro-qwen3.8-flash-next/ROLLING_JUDGE_STOP. Same server args as 038/039/041: no restart.
MODEL=Qwen/Qwen3.6-27B
SERVE_ARGS="--dp-size 2 --reasoning-parser qwen3 --mem-fraction-static 0.90 --cuda-graph-max-bs 128 --mamba-full-memory-ratio 2.0"
CTX=32768
B0=/fs04/scratch2/ub62/ssim0070/benchmark_runs
source $B0/local_weights.sh; local_weights "$MODEL" || return 1
[ "$MODEL|${CTX:-65536}|${SERVE_ARGS:-}" != "${CUR:-}" ] && bash $B0/clean_gpu.sh
run() {
  local STOP=$B0/dx/medagentpro-qwen3.8-flash-next/ROLLING_JUDGE_STOP s
  while [ ! -f $STOP ]; do
    for s in medagentpro-qwen3.5-27b medagentpro-qwen3.8-flash-next; do
      python3 - $B0/dx/$s <<'PY' || continue
import json, os, sys
from pathlib import Path
D = Path(sys.argv[1])
for t in ("T1.1", "T1.2"):
    d = D / t; rows = {}; sigs = set()
    for f in sorted(d.glob("predictions.p*.jsonl")):
        for l in open(f):
            try: r = json.loads(l)
            except Exception: continue
            sigs.add(r.get("run_sig")); rows.setdefault(r["_id"], r)
    if not rows: continue
    if len(sigs) > 1: sys.exit(f"[rolling-merge] {d}: {len(sigs)} run_sigs: refusing")
    tmp = d / f"predictions.jsonl.tmp{os.getpid()}"
    with open(tmp, "w") as fo:
        for r in rows.values(): fo.write(json.dumps(r, ensure_ascii=False) + "\n")
    os.replace(tmp, d / "predictions.jsonl"); print(f"[rolling-merge] {d}: {len(rows)} rows")
PY
      echo "[rolling-judge] $(date '+%m-%d %H:%M') $s (SCORE.txt PARTIAL)"
      DX_JUDGE_PASSES=3 DX_JUDGE_WORKERS=48 bash $B0/tools/guarded.sh "${OPENROUTER_BASE_URL%/v1}/health" bash $B0/dx/judge_dx.sh $s
    done
    UNF=$(python3 - <<'PY2'
import json,glob
D="/fs04/scratch2/ub62/ssim0070/benchmark_runs/dx/medagentpro-qwen3.5-27b"; R="/fs04/scratch2/ub62/ssim0070/DermArena_release/DermArena_v1/tasks"; n=0
for t,d in (("T1.1","T1.1_disease_screening"),("T1.2","T1.2_disease_confirmation")):
    done=set()
    for f in glob.glob(f"{D}/{t}/predictions.p*.jsonl"):
        for l in open(f):
            try: done.add(json.loads(l)["_id"])
            except Exception: pass
    n+=sum(1 for l in open(f"{R}/{d}/test.jsonl") if l.strip() and json.loads(l)["_id"] not in done)
print(n)
PY2
)
    [ "${UNF:-1}" = 0 ] && { echo "[rolling-judge] Qwen inference complete: hand over to 041"; return 0; }
    echo "[rolling-judge] $(date '+%m-%d %H:%M') $UNF Qwen cases unfinished; next pass in 20 min"; sleep 1200
  done
}
