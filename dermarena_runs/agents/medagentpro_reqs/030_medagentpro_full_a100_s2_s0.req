# 030 (gpu2a100) — Qwen FULL: own shard 2 + orphaned shard 0 on this A100 server (32+32 threads), tools L40S GPU 0 and GPU 2. 11-09: H100 gone, no replacement yet.
MODEL=Qwen/Qwen3.5-27B
SERVE_ARGS="--tp-size 2 --reasoning-parser qwen3 --tool-call-parser qwen3_coder --mem-fraction-static 0.90 --cuda-graph-max-bs 64 --mamba-full-memory-ratio 2.0"
CTX=131072
source /fs04/scratch2/ub62/ssim0070/benchmark_runs/local_weights.sh; local_weights "$MODEL" || return 1
[ "$MODEL|${CTX:-65536}|${SERVE_ARGS:-}" != "${CUR:-}" ] && bash /fs04/scratch2/ub62/ssim0070/benchmark_runs/clean_gpu.sh
run() {
  local B=/fs04/scratch2/ub62/ssim0070/benchmark_runs S=medagentpro-qwen3.5-27b L=61714874 D=/fs04/scratch2/ub62/ssim0070/benchmark_runs/dx/medagentpro-qwen3.5-27b
  [ -n "${MP_TEST_B:-}" ] && B=$MP_TEST_B && D=$MP_TEST_B/d
  local URL=${OPENROUTER_BASE_URL/127.0.0.1/$(hostname)} HEALTH=${OPENROUTER_BASE_URL%/v1}/health
  local COMMON="MP_SLUG=$S MP_BACKBONE=Qwen/Qwen3.5-27B MP_NPROC=1 MP_THREADS=32 MP_SHARD_TOTAL=4 MP_ALLOC_CONF=expandable_segments:True"
  # own shard 2 (32 threads), tools on L40S GPU 0
  MP_REMOTE_CPUS=4 MP_REMOTE_MEM=16G bash $B/tools/guarded.sh "$HEALTH" bash $B/agents/run_medagentpro_remote_v2.sh $L "$URL" full \
    $COMMON "MP_TOOL_GPUS='0'" MP_SHARD_BASE=2 "MP_SERVER_ARGS='$SERVE_ARGS --context-length $CTX'" &
  local own=$!
  sleep ${MP_TEST_SLEEP:-20}
  # extra shard 0 (orphaned since the H100 ended), tools on L40S GPU 2: runs until a replacement holder creates locks/TAKEOVER_01
  local extra=""
  if [ ! -f $D/locks/TAKEOVER_01 ]; then
    MP_REMOTE_CPUS=4 MP_REMOTE_MEM=16G bash $B/tools/guarded.sh "$HEALTH" bash $B/agents/run_medagentpro_remote_v2.sh $L "$URL" full \
      $COMMON "MP_TOOL_GPUS='2'" MP_SHARD_BASE=0 "MP_SERVER_ARGS='$SERVE_ARGS --context-length $CTX'" &
    extra=$!
    while kill -0 $extra 2>/dev/null; do
      if [ -f $D/locks/TAKEOVER_01 ]; then
        echo "[extra shard 0] takeover flag seen $(date): stopping it"
        for c in $(pgrep -P $extra); do kill -TERM -- -$c 2>/dev/null; done; kill $extra 2>/dev/null; break
      fi
      sleep ${MP_TEST_POLL:-30}
    done
  fi
  wait $own; local rc=$?
  [ -n "$extra" ] && wait $extra 2>/dev/null
  return $rc
}
