# 040 (gpu2a100 / gpu2a100b, 11-10) — judge the MedAgent-Pro x Qwen3.5-27B FULL run (T1.1 + T1.2) with Qwen3.6-27B (dp2) as soon as inference is done.
# Runs after this holder's shard request ends. One holder judges (lock dx/medagentpro-qwen3.5-27b/locks/judge); the other returns at once.
# Waits (server loaded) until: all 4 shards have 0 unfinished cases, no runner is alive on any tools host, and the merged predictions.jsonl
# of both tasks is newer than every shard file (the last runner's merge step). Then judge_dx.sh (resumable) -> SCORE.txt + SPOTCHECK.md.
MODEL=Qwen/Qwen3.6-27B
SERVE_ARGS="--dp-size 2 --reasoning-parser qwen3 --mem-fraction-static 0.90 --cuda-graph-max-bs 128 --mamba-full-memory-ratio 2.0"
CTX=32768
B0=/fs04/scratch2/ub62/ssim0070/benchmark_runs
# 11-11 DEFERRED: while any Qwen case is unfinished, KEEP the current (Qwen) server - other shards may use it - and re-queue this request
# (alternating 040/041 file names) to check again in 10 min. Only when inference is complete does the holder switch to the judge.
UNF=$(python3 - "$B0/dx/medagentpro-qwen3.5-27b" <<'PY2'
import json,glob,sys
D=sys.argv[1]; R="/fs04/scratch2/ub62/ssim0070/DermArena_release/DermArena_v1/tasks"; n=0
for t,d in (("T1.1","T1.1_disease_screening"),("T1.2","T1.2_disease_confirmation")):
    done=set()
    for f in glob.glob(f"{D}/{t}/predictions.p*.jsonl"):
        for l in open(f):
            try: done.add(json.loads(l)["_id"])
            except Exception: pass
    n+=sum(1 for l in open(f"{R}/{d}/test.jsonl") if l.strip() and json.loads(l)["_id"] not in done)
print(n)
PY2
)
if [ "${UNF:-1}" != 0 ] && [ -n "${CUR:-}" ]; then
  MODEL=${CUR%%|*}; CTX=$(echo "$CUR" | cut -d'|' -f2); SERVE_ARGS=$(echo "$CUR" | cut -d'|' -f3-)
  run() { echo "[mp-judge] $(date '+%m-%d %H:%M') $UNF Qwen cases unfinished: keeping the Qwen server, check again in 10 min"; sleep 600
          local nb=040_judge_medagentpro_qwen.req; [ "$(basename $req)" = $nb ] && nb=041_judge_medagentpro_qwen.req
          cp $B0/agents/medagentpro_reqs/040_judge_medagentpro_qwen.req $Q/$nb; }
  return 0
fi
NOWAIT=1 bash $B0/agents/mp_shard_lock.sh $B0/dx/medagentpro-qwen3.5-27b/locks/judge $SLURM_JOB_ID || { MODEL=""; }
if [ -z "$MODEL" ]; then MODEL=${CUR%%|*}; CTX=$(echo "$CUR" | cut -d'|' -f2); SERVE_ARGS=$(echo "$CUR" | cut -d'|' -f3-); run() { echo "judge taken by another holder"; return 0; }; return 0; fi
source $B0/local_weights.sh; local_weights "$MODEL" || return 1
[ "$MODEL|${CTX:-65536}|${SERVE_ARGS:-}" != "${CUR:-}" ] && bash $B0/clean_gpu.sh
run() {
  local B=$B0 D=$B0/dx/medagentpro-qwen3.5-27b
  SLUG=medagentpro-qwen3.5-27b; source $B/agents/mp_hosts.sh
  while true; do
    rem=$(python3 - "$D" <<'PY'
import json,glob,sys
D=sys.argv[1]; R="/fs04/scratch2/ub62/ssim0070/DermArena_release/DermArena_v1/tasks"; n=0
for t,d in (("T1.1","T1.1_disease_screening"),("T1.2","T1.2_disease_confirmation")):
    done=set()
    for f in glob.glob(f"{D}/{t}/predictions.p*.jsonl"):
        for l in open(f):
            try: done.add(json.loads(l)["_id"])
            except Exception: pass
    n+=sum(1 for l in open(f"{R}/{d}/test.jsonl") if l.strip() and json.loads(l)["_id"] not in done)
print(n)
PY
)
    run_n=$(all_runners | grep -c .)
    fresh=1; for t in T1.1 T1.2; do for f in $D/$t/predictions.p*.jsonl; do [ $D/$t/predictions.jsonl -nt $f ] || fresh=0; done; done
    echo "[mp-judge] $(date '+%m-%d %H:%M') unfinished=$rem runners=$run_n merged_fresh=$fresh"
    [ "$rem" = 0 ] && [ "$run_n" = 0 ] && [ $fresh = 1 ] && break
    sleep 600
  done
  DX_JUDGE_PASSES=3 DX_JUDGE_WORKERS=48 bash $B/tools/guarded.sh "${OPENROUTER_BASE_URL%/v1}/health" bash $B/dx/judge_dx.sh medagentpro-qwen3.5-27b
}
