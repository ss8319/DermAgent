# 090 — MedAgent-Pro x Qwen3.5-27B FULL run, H100 group: global shards 0-1 of 4 (gpu2a100 runs shards 2-3 on a second server).
# Waits for nothing: refuses unless canary_iclr3 passed its integrity check. Plans: owner accepted without review (REVIEWED, 11-08).
MODEL=Qwen/Qwen3.5-27B
SERVE_ARGS="--tp-size 2 --reasoning-parser qwen3 --tool-call-parser qwen3_coder --mem-fraction-static 0.90 --cuda-graph-max-bs 64 --mamba-full-memory-ratio 2.0"
CTX=131072
source /fs04/scratch2/ub62/ssim0070/benchmark_runs/local_weights.sh; local_weights "$MODEL" || return 1
[ "$MODEL|${CTX:-65536}|${SERVE_ARGS:-}" != "${CUR:-}" ] && bash /fs04/scratch2/ub62/ssim0070/benchmark_runs/clean_gpu.sh
run() {
  local B=/fs04/scratch2/ub62/ssim0070/benchmark_runs S=medagentpro-qwen3.5-27b A=/fs04/scratch2/ub62/ssim0070/benchmark_runs/agents/run_medagentpro_v2.sh
  local D=$B/dx/$S
  [ -f $D/canary_iclr3/PASSED_INTEGRITY ] || { echo "canary_iclr3 did not pass its integrity check: no full run"; return 1; }
  MP_SLUG=$S MP_BACKBONE=Qwen/Qwen3.5-27B MP_TOOL_GPUS="2 3" MP_NPROC=2 MP_THREADS=32 MP_SHARD_BASE=0 MP_SHARD_TOTAL=4 \
    MP_ALLOC_CONF=expandable_segments:True MP_SERVER_ARGS="$SERVE_ARGS --context-length $CTX" \
    bash $B/tools/guarded.sh "${OPENROUTER_BASE_URL%/v1}/health" bash $A full
}
