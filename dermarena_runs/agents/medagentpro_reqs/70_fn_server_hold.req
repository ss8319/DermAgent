# 70 (11-12): Flash-Next SERVER HOLD for MedAgent-Pro (optimisation #2). Loads Flash-Next (same args as 61 -> no restart on h200x4d), registers
# its URL in dx/medagentpro-qwen3.8-flash-next/servers/<job>.url and holds while Flash-Next cases remain. The runners are started by
# agents/mp_fn_supervisor.sh (8 shards over every registered server, tools on other jobs' GPUs).
# DEFERRED on a node that still hosts MedAgent-Pro tool processes (bdiimg: Qwen tools on GPU 2, the old Flash-Next run's on GPU 3): keep the
# current server and re-queue this request (70/71) every 10 min, so the swap never fights live tools for GPU memory.
B0=/fs04/scratch2/ub62/ssim0070/benchmark_runs
if pgrep -u $USER -f "[r]un_dermarena_v1_medagentpro.py" >/dev/null && [ -n "${CUR:-}" ]; then
  MODEL=${CUR%%|*}; CTX=$(echo "$CUR" | cut -d'|' -f2); SERVE_ARGS=$(echo "$CUR" | cut -d'|' -f3-)
  run() { echo "[fn-hold] $(date '+%m-%d %H:%M') MedAgent-Pro tool processes still on $(hostname): keep the current server, check again in 10 min"; sleep 600
          local nb=70_fn_server_hold.req; [ "$(basename $req)" = $nb ] && nb=71_fn_server_hold.req
          cp $B0/agents/medagentpro_reqs/70_fn_server_hold.req $Q/$nb; }
  return 0
fi
MODEL=Qwen/Qwen3.8-Flash-Next
SERVE_ARGS="--tp-size 4 --ep-size 4 --dtype bfloat16 --reasoning-parser qwen3 --tool-call-parser qwen3_coder --chunked-prefill-size 8192 --max-running-requests 160 --cuda-graph-max-bs-decode 160"
CTX=81920
source $B0/local_weights.sh; local_weights "$MODEL" || return 1
export SGLANG_CONTAINER=/fs04/scratch2/ub62/ssim0070/sglang/containers/sglang_v0522.sif
export CONTAINER_HOME=/fs04/scratch2/ub62/ssim0070/sglang/.container_home_v0522
mkdir -p $CONTAINER_HOME/.cache/flashinfer $CONTAINER_HOME/.cache/torch $CONTAINER_HOME/.triton
[ -s "$SGLANG_CONTAINER" ] || { echo "missing $SGLANG_CONTAINER"; return 1; }
[ "$MODEL|${CTX:-65536}|${SERVE_ARGS:-}" != "${CUR:-}" ] && bash $B0/clean_gpu.sh
run() {
  local D=$B0/dx/medagentpro-qwen3.8-flash-next URL=${OPENROUTER_BASE_URL/127.0.0.1/$(hostname)}
  mkdir -p $D/servers; echo "$URL" > $D/servers/$SLURM_JOB_ID.url
  echo "[fn-hold] $(date '+%m-%d %H:%M') serving $URL for the Flash-Next supervisor"
  while [ ! -f $D/servers/HOLD_STOP ]; do
    left=$(python3 - "$D" <<'PY'
import json,glob,sys
D=sys.argv[1]; R="/fs04/scratch2/ub62/ssim0070/DermArena_release/DermArena_v1/tasks"; n=0
for t,d in (("T1.1","T1.1_disease_screening"),("T1.2","T1.2_disease_confirmation")):
    done=set()
    for f in glob.glob(f"{D}/{t}/predictions.p*.jsonl"):
        for l in open(f):
            try: done.add(json.loads(l)["_id"])
            except Exception: pass
    n+=sum(1 for l in open(f"{R}/{d}/test.jsonl") if l.strip() and json.loads(l)["_id"] not in done)
print(n)
PY
)
    [ "${left:-1}" = 0 ] && break
    sleep 600
  done
  rm -f $D/servers/$SLURM_JOB_ID.url; echo "[fn-hold] $(date '+%m-%d %H:%M') Flash-Next done (or HOLD_STOP): release"
}
