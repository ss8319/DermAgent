# 038 (gpu2a100, 11-12 12:00): EARLY judge of MedAgent-Pro x Qwen3.8-Flash-Next on the cases finished so far (T1.1 ~1,800), so the
# A100s don't idle while Qwen inference finishes (its early judge 039 is done). Same judge server as 039/040 (Qwen3.6-27B dp2: no restart).
# Merge first, race-safe (PR #3 review finding 1: the runners' merge uses a fixed tmp name; this one is unique + os.replace, and it
# refuses a folder whose rows carry more than one run_sig, finding 3). Resumable: later judge passes grade only the new cases.
MODEL=Qwen/Qwen3.6-27B
SERVE_ARGS="--dp-size 2 --reasoning-parser qwen3 --mem-fraction-static 0.90 --cuda-graph-max-bs 128 --mamba-full-memory-ratio 2.0"
CTX=32768
B0=/fs04/scratch2/ub62/ssim0070/benchmark_runs
source $B0/local_weights.sh; local_weights "$MODEL" || return 1
[ "$MODEL|${CTX:-65536}|${SERVE_ARGS:-}" != "${CUR:-}" ] && bash $B0/clean_gpu.sh
run() {
  local D=$B0/dx/medagentpro-qwen3.8-flash-next
  python3 - $D <<'PY' || return 1
import json, os, sys, glob
from pathlib import Path
D = Path(sys.argv[1])
for t in ("T1.1", "T1.2"):
    d = D / t; rows = {}; sigs = set()
    for f in sorted(d.glob("predictions.p*.jsonl")):
        for l in open(f):
            try: r = json.loads(l)
            except Exception: continue
            sigs.add(r.get("run_sig")); rows.setdefault(r["_id"], r)
    if len(sigs) > 1: sys.exit(f"[fn-early-merge] {d}: rows carry {len(sigs)} run_sigs {sigs}: refusing to merge")
    tmp = d / f"predictions.jsonl.tmp{os.getpid()}"
    with open(tmp, "w") as fo:
        for r in rows.values(): fo.write(json.dumps(r, ensure_ascii=False) + "\n")
    os.replace(tmp, d / "predictions.jsonl"); print(f"[fn-early-merge] {d}: {len(rows)} rows, run_sig {sigs}")
PY
  echo "[fn-judge-early] $(date '+%m-%d %H:%M') start (SCORE.txt is PARTIAL until the run ends)"
  DX_JUDGE_PASSES=3 DX_JUDGE_WORKERS=48 bash $B0/tools/guarded.sh "${OPENROUTER_BASE_URL%/v1}/health" bash $B0/dx/judge_dx.sh medagentpro-qwen3.8-flash-next
}
