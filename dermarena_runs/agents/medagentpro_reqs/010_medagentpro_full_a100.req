# 010 (gpu2a100) — MedAgent-Pro x Qwen3.5-27B FULL run, A100 group: second Qwen server here (same SERVE_ARGS as the H100, tp2 on 2 x A100-80G),
# tools on the other idle A100 pair (job 61981434, 2 procs), global shards 2-3 of 4. Waits until canary_iclr3 passes its integrity check.
MODEL=Qwen/Qwen3.5-27B
SERVE_ARGS="--tp-size 2 --reasoning-parser qwen3 --tool-call-parser qwen3_coder --mem-fraction-static 0.90 --cuda-graph-max-bs 64 --mamba-full-memory-ratio 2.0"
CTX=131072
source /fs04/scratch2/ub62/ssim0070/benchmark_runs/local_weights.sh; local_weights "$MODEL" || return 1
[ "$MODEL|${CTX:-65536}|${SERVE_ARGS:-}" != "${CUR:-}" ] && bash /fs04/scratch2/ub62/ssim0070/benchmark_runs/clean_gpu.sh
run() {
  local B=/fs04/scratch2/ub62/ssim0070/benchmark_runs S=medagentpro-qwen3.5-27b L=61981434 D=/fs04/scratch2/ub62/ssim0070/benchmark_runs/dx/medagentpro-qwen3.5-27b
  local URL=${OPENROUTER_BASE_URL/127.0.0.1/$(hostname)}
  until [ -f $D/canary_iclr3/PASSED_INTEGRITY ]; do [ -f $D/canary_iclr3/FAILED_INTEGRITY ] && { echo "canary_iclr3 failed: no full run"; return 1; }; sleep 120; done
  srun --jobid=$L --overlap --cpu-bind=none -n1 -c1 --mem=1G bash $B/clean_gpu.sh
  MP_REMOTE_CPUS=12 MP_REMOTE_MEM=150G bash $B/tools/guarded.sh "${OPENROUTER_BASE_URL%/v1}/health" bash $B/agents/run_medagentpro_remote_v2.sh $L "$URL" full \
    MP_SLUG=$S MP_BACKBONE=Qwen/Qwen3.5-27B "MP_TOOL_GPUS='0 1'" MP_NPROC=2 MP_THREADS=32 MP_SHARD_BASE=2 MP_SHARD_TOTAL=4 \
    MP_ALLOC_CONF=expandable_segments:True "MP_SERVER_ARGS='$SERVE_ARGS --context-length $CTX'"
}
