# 10 (11-13, owner GO "run with best plan"): Flash-Next SERVER for MedAgent-Pro on ANY 4-GPU holder (H200, A100-80G or H100).
# - H200: the 11-13 settings (cap 220, owner OK). A100/H100 (80 GB): prefix cache off (1 mamba slot per request instead of 5), cap 96,
#   prefill CUDA graph off, mem-fraction 0.92 (FN_MF), expandable segments. Same model, weights, bf16, fp32 mamba state, sampling.
#   Memory arithmetic + options: diagnostics/flashnext_no_h200_20261113/NOTES.md. Scheduling/memory flags only (sglang/CLAUDE.md Rule 8).
# - A100/H100 must first PASS tools/fn_refcheck.py against the H200 reference (20 prompts: teacher-forced logprobs + greedy text),
#   because A100 is not on the model's supported list. FAIL -> no runner ever uses this server; it stops (watchdog releases the job).
# - PASS (or H200) -> registers dx/<slug>/servers/<job>.url + <job>.args (the runner's MP_SERVER_ARGS -> run_sig, so every case
#   records which server config produced it) and holds until every Flash-Next case is done or servers/HOLD_STOP.
# - Runners are started by agents/mp_fn_supervisor2.sh (tools on the A40 / spare A100), never on this node.
# - 11_fn_server_v2_mf090.req retries with mem-fraction 0.90 only if THIS request failed to START (not after a refcheck FAIL).
B0=/fs04/scratch2/ub62/ssim0070/benchmark_runs; FND=$B0/dx/medagentpro-qwen3.8-flash-next
GPU=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -1)
MODEL=Qwen/Qwen3.8-Flash-Next; CTX=81920
case "$GPU" in
  *H200*) SERVE_ARGS="--tp-size 4 --ep-size 4 --dtype bfloat16 --reasoning-parser qwen3 --tool-call-parser qwen3_coder --chunked-prefill-size 8192 --max-running-requests 220 --cuda-graph-max-bs-decode 224" ;;
  *)      SERVE_ARGS="--tp-size 4 --ep-size 4 --dtype bfloat16 --reasoning-parser qwen3 --tool-call-parser qwen3_coder --chunked-prefill-size 4096 --disable-radix-cache --max-running-requests 96 --cuda-graph-max-bs-decode 96 --disable-prefill-cuda-graph --mem-fraction-static ${FN_MF:-0.90}"
          # 11-13 19:35: custom all-reduce failed CUDA-graph capture on A100 PCIe (no NVLink; custom_all_reduce.cuh:614) -> NCCL AR there
          nvidia-smi topo -m | grep -qE "NV[0-9]+" || SERVE_ARGS="$SERVE_ARGS --disable-custom-all-reduce"
          export APPTAINERENV_PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True ;;
esac
source $B0/local_weights.sh; local_weights "$MODEL" || return 1
export SGLANG_CONTAINER=/fs04/scratch2/ub62/ssim0070/sglang/containers/sglang_v0522.sif
export CONTAINER_HOME=/fs04/scratch2/ub62/ssim0070/sglang/.container_home_v0522
mkdir -p $CONTAINER_HOME/.cache/flashinfer $CONTAINER_HOME/.cache/torch $CONTAINER_HOME/.triton
[ -s "$SGLANG_CONTAINER" ] || { echo "missing $SGLANG_CONTAINER"; return 1; }
[ "$MODEL|${CTX:-65536}|${SERVE_ARGS:-}" != "${CUR:-}" ] && bash $B0/clean_gpu.sh
run() {
  local URL=${OPENROUTER_BASE_URL/127.0.0.1/$(hostname)} J=$SLURM_JOB_ID left rc
  local ARGS="$(echo "$SERVE_ARGS" | sed 's/  */ /g') --context-length $CTX"
  mkdir -p $FND/servers
  hist() { printf "%s\t%s\t%s\t%s\t%s\t%s\n" "$(date '+%F %T')" $J $(hostname) "$GPU" "$1" "$ARGS" >> $FND/servers/history.tsv; }
  echo "[fn-v2] $(date '+%m-%d %H:%M') server up on $(hostname) ($GPU): $URL"
  grep -E "max_running_requests|avail mem|capped|KV Cache is allocated|Mamba Cache is allocated" $OUT/server_${J}.log | tail -8
  case "$GPU" in *H200*) ;; *)
    hist refcheck_start
    for a in 1 2 3; do   # 11-14 review: rc 2 = could not run (e.g. a transient HTTP error): retry, do not drop a good server
      python3 $B0/tools/fn_refcheck.py compare "$URL" $B0/diagnostics/flashnext_no_h200_20261113/refcheck; rc=$?
      [ $rc -ne 2 ] && break; echo "[fn-v2] refcheck could not run (attempt $a), retrying in 2 min"; sleep 120
    done
    # 11-13 21:05: rc 3 = PASS_NOISE_CAP (only the per-prompt cap exceeded, worst < 0.5); accepted while the owner-OK'd override exists
    [ $rc -eq 3 ] && [ -f $FND/servers/A100_REFCHECK_OVERRIDE ] && { hist refcheck_PASS_NOISE_CAP_override; rc=0; }
    if [ $rc -ne 0 ]; then
      touch $FND/servers/REFCHECK_FAILED_$J; hist "refcheck_FAIL_rc$rc"
      echo "$(date '+%m-%d %H:%M') FN-REFCHECK FAIL $J $(hostname) ($GPU) rc=$rc: server NOT used; see diagnostics/flashnext_no_h200_20261113/refcheck" >> $B0/logs/gpu_watchdog/alerts.log
      return 1
    fi
    hist refcheck_PASS ;;
  esac
  echo "$URL" > $FND/servers/$J.url.tmp; echo "$ARGS" > $FND/servers/$J.args; mv $FND/servers/$J.url.tmp $FND/servers/$J.url
  hist serving; echo "[fn-v2] $(date '+%m-%d %H:%M') registered $URL for mp_fn_supervisor2"
  # 11-13 (owner goal "finish T1.1 first"): if the holder queue has HOLD_T11_ONLY and this is the 10_ request, release the server
  # as soon as every T1.1 case is done, so the next request (12_judge_fn_t11.req) judges T1.1, then 13_ resumes Flash-Next for T1.2.
  local T11=0; [ -f $Q/HOLD_T11_ONLY ] && [[ "$(basename "$req")" == 10_* ]] && T11=1
  [ $T11 = 1 ] && echo "[fn-v2] HOLD_T11_ONLY: this server releases when T1.1 is complete"
  # 11-14 auto-fallback: the server is health-checked every 60 s while it holds. After 3 failures in a row it is DEAD: unregister,
  # mark DIED_<job> (11_ then does not retry), and queue a relaunch IN THIS ALLOCATION (10r<n>, sorts before 11_; at most 3; the
  # 2nd+ use mem-fraction 0.88 on 80 GB GPUs). Before this, a crashed server left run() sleeping forever and 4 GPUs idle.
  # 11-14 review: markers are keyed by job AND requeue count (a requeued bdi job keeps its id), so a requeue starts fresh.
  # RELEASE_<job> (written by mp_fn_supervisor3 when this server had no runner for 60 min and no role is waiting): stop holding,
  # so the job empties and the watchdog releases it instead of 4 GPUs idling for days (M3 cancels idle GPU jobs).
  local hf=0 it=0 n MK=${J}_${SLURM_RESTART_COUNT:-0}
  rm -f $FND/servers/RELEASE_$J $FND/servers/DRAIN_$J
  # 11-15 DRAIN: FN_DRAIN_S (3 h) before this job's walltime, touch DRAIN_<job> (its runner's MP_STOP_FILE: no new cases, in-flight
  # ones finish) and unregister, so ~a full batch of multi-hour cases is not killed mid-way at walltime (H200 fit job = 12 h).
  local END=""
  while [ ! -f $FND/servers/HOLD_STOP ]; do
    if [ -f $FND/servers/RELEASE_$J ]; then
      rm -f $FND/servers/RELEASE_$J; hist released_no_runner
      echo "$(date '+%m-%d %H:%M') FN-SERVER $J $(hostname) ($GPU): no runner for 60 min and no role waiting: released (watchdog frees the job)" >> $B0/logs/gpu_watchdog/alerts.log
      break
    fi
    [ -z "$END" ] && END=$(date -d "$(squeue -h -j $J -o %e 2>/dev/null)" +%s 2>/dev/null)
    if [ -n "$END" ] && [ ! -f $FND/servers/DRAIN_$J ] && [ $(( END - $(date +%s) )) -lt ${FN_DRAIN_S:-10800} ]; then
      touch $FND/servers/DRAIN_$J; rm -f $FND/servers/$J.url; hist draining
      echo "$(date '+%m-%d %H:%M') FN-SERVER $J $(hostname) ($GPU): $(( (END - $(date +%s)) / 60 )) min to walltime: DRAIN (no new cases; in-flight cases finish)" >> $B0/logs/gpu_watchdog/alerts.log
    fi
    if curl -sf -m 30 http://127.0.0.1:$PORT/health >/dev/null; then hf=0; else hf=$((hf+1)); fi
    if [ $hf -ge 3 ]; then
      rm -f $FND/servers/$J.url; touch $FND/servers/DIED_$MK
      n=$(( $(cat $FND/servers/relaunches_$MK 2>/dev/null || echo 0) + 1 )); echo $n > $FND/servers/relaunches_$MK; hist "DEAD_relaunch_$n"
      # 11-14 review: stop the (possibly wedged, not crashed) server now, so the relaunch always starts fresh and nothing hangs on it
      kill $SP 2>/dev/null; bash $B0/clean_gpu.sh
      if [ $n -le 3 ]; then
        { [ $n -ge 2 ] && echo "FN_MF=0.88"; cat $B0/agents/medagentpro_reqs/10_fn_server_v2.req; } > $Q/10r${n}_fn_server_relaunch.req
        echo "$(date '+%m-%d %H:%M') FN-SERVER DIED $J $(hostname) ($GPU): relaunch $n/3 queued in the same allocation (see $OUT/server_${J}.log)" >> $B0/logs/gpu_watchdog/alerts.log
      else
        echo "$(date '+%m-%d %H:%M') FN-SERVER DIED $J $(hostname) ($GPU) for the 4th time: no more relaunches; the holder empties and the watchdog releases it" >> $B0/logs/gpu_watchdog/alerts.log
      fi
      return 1
    fi
    it=$((it+1)); [ $(( (it - 1) % 10 )) -ne 0 ] && { sleep 60; continue; }   # case count every 10 min
    left=$(python3 - "$FND" $T11 <<'PY'
import json,glob,sys
D=sys.argv[1]; R="/fs04/scratch2/ub62/ssim0070/DermArena_release/DermArena_v1/tasks"; n=0
for t,d in (("T1.1","T1.1_disease_screening"),("T1.2","T1.2_disease_confirmation"))[:1 if sys.argv[2:3]==["1"] else 2]:
    done=set()
    for f in glob.glob(f"{D}/{t}/predictions.p*.jsonl"):
        for l in open(f):
            try: done.add(json.loads(l)["_id"])
            except Exception: pass
    n+=sum(1 for l in open(f"{R}/{d}/test.jsonl") if l.strip() and json.loads(l)["_id"] not in done)
print(n)
PY
)
    [ "${left:-1}" = 0 ] && break
    sleep 60
  done
  rm -f $FND/servers/$J.url; hist released$([ $T11 = 1 ] && echo _T11_done); echo "[fn-v2] $(date '+%m-%d %H:%M') Flash-Next done (T1.1-only=$T11, or HOLD_STOP): release"
}
