# H200 (11-10, owner: ablation before Flash-Next this week) — judge GLM-4.6V findings-kept right after its inference (11-10 v2 order: GLM first on the H200).
MODEL=Qwen/Qwen3.6-27B
SERVE_ARGS="--dp-size 4 --reasoning-parser qwen3 --mem-fraction-static 0.90 --cuda-graph-max-bs 128 --mamba-full-memory-ratio 2.0"
CTX=32768
source /fs04/scratch2/ub62/ssim0070/benchmark_runs/local_weights.sh; local_weights "$MODEL" || return 1
[ "$MODEL|${CTX:-65536}|${SERVE_ARGS:-}" != "${CUR:-}" ] && bash /fs04/scratch2/ub62/ssim0070/benchmark_runs/clean_gpu.sh
run() { DX_JUDGE_PASSES=3 DX_JUDGE_WORKERS=64 bash /fs04/scratch2/ub62/ssim0070/benchmark_runs/tools/guarded.sh "${OPENROUTER_BASE_URL%/v1}/health" bash /fs04/scratch2/ub62/ssim0070/benchmark_runs/dx/judge_dx.sh glm-4.6v-findingskept; }
